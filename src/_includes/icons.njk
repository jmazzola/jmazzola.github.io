{#- Single icon set: Lucide geometry (24px grid, 1.75 stroke), inlined so the site ships zero icon JS. -#}
{%- macro svg(name, size=18) -%}
<svg class="icon icon-{{ name }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if name == "arrow-right" -%}<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
{%- elif name == "arrow-left" -%}<path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
{%- elif name == "arrow-up-right" -%}<path d="M7 7h10v10"/><path d="M7 17 17 7"/>
{%- elif name == "menu" -%}<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h10"/>
{%- elif name == "close" -%}<path d="M18 6 6 18"/><path d="m6 6 12 12"/>
{%- elif name == "map-pin" -%}<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>
{%- elif name == "terminal" -%}<path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>
{%- elif name == "rss" -%}<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>
{%- elif name == "search-x" -%}<path d="m13.5 8.5-5 5"/><path d="m8.5 8.5 5 5"/><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
{%- endif -%}
</svg>
{%- endmacro -%}

{#- X (Twitter) brand mark is filled, not stroked. -#}
{%- macro xlogo(size=16) -%}
<svg class="icon icon-x" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
{%- endmacro -%}

